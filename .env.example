DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
PORT=8787
WEB_ORIGIN=http://localhost:5173
HEADLESS=true
# Optional: chrome uses an isolated installed Google Chrome; empty uses Playwright Chromium.
REPROLENS_BROWSER_CHANNEL=
REPROLENS_EVAL_CHANNEL=
# Comma-separated trusted origins for opt-in observation; default: this local API only.
# This is not a public multi-tenant browser sandbox. Never add untrusted/private services.
REPROLENS_OBSERVATION_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
REPROLENS_GITHUB_TOKEN=
REPROLENS_GITHUB_WEBHOOK_SECRET=
REPROLENS_GITHUB_TRIGGER_LABEL=needs-reproduction
